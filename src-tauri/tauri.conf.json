{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Note",
  "version": "0.1.0",
  "identifier": "com.note.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Note - 笔记本",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "visible": true,
        "create": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$DOCUMENT/NoteData/**",
          "$HOME/Documents/NoteData/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "小岛笔记",
    "longDescription": "本地桌面笔记本，支持时间流、标签、图片和悬浮窗快速记录。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
